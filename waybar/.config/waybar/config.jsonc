{
    "layer": "top",
    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "hyprland/mode"
    ],

    "modules-center": [
        "hyprland/windows"
    ],

    "modules-right": [
        "custom/bluetooth",
        "network",
        "pulseaudio",
        "battery",
        "custom/clock"
    ],

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "custom/clock": {
        "exec": "~/.config/waybar/scripts/clock-daemon.sh",
        "return-type": "json",
        "on-click": "sh -c 'echo toggle > \"${XDG_RUNTIME_DIR:-/tmp}/waybar-clock.fifo\"'"
    },

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/workspace.py 1",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/workspace.py 2",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/workspace.py 3",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/workspace.py 4",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/workspace.py 5",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },

    "network": {
        "format-wifi": "󰖩  {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤮  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bt-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/bt-menu.sh"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""],
            "headphone": "",
            "headset": ""
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    }
}