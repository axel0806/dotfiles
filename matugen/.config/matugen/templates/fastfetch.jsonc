// Generated by matugen from {{image}}. Do not edit: wallpaper.sh rewrites it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}", "2": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}" }
  },
  "display": {
    "color": {
      "title": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "at": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "underline": "38;2;{{colors.outline_variant.default.red}};{{colors.outline_variant.default.green}};{{colors.outline_variant.default.blue}}",
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "separator": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
      "output": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
    }
  },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages",
    { "type": "command", "key": "Shell", "text": "$SHELL --version | cut -d' ' -f1,2" },
    "wm", "terminal", "cpu", "memory", "break", "colors"
  ]
}
