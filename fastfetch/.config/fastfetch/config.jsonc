{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // palette from the twilight wallpaper: crimson, ember, dusk gold, sky teal
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "38;2;240;136;62", "2": "38;2;240;136;62" }
  },
  "display": {
    "color": {
      "title": "38;2;240;136;62",
      "at": "38;2;240;136;62",
      "underline": "38;2;120;54;48",
      "keys": "38;2;240;136;62",
      "separator": "38;2;63;167;160",
      "output": "38;2;222;206;160"
    }
  },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages",
    { "type": "command", "key": "Shell", "text": "$SHELL --version | cut -d' ' -f1,2" },
    "wm", "terminal", "cpu", "memory", "break", "colors"
  ]
}
